{
    "name": "pfefferle/webfinger-cli",
    "description": "Web version of the finger protocol",
    "keywords": ["finger", "webfinger", "fediverse", "activitypub"],
    "homepage": "https://webfinger.net/",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthias Pfefferle",
            "email": "matthias@pfefferle.org"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "symfony/console": "^7.4 || ^8.0",
        "mf2/mf2": "^0.5.0",
        "barnabywalters/mf-cleaner": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Pfefferle\\WebFinger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pfefferle\\WebFinger\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/webfinger"
    ],
    "scripts": {
        "test": "phpunit",
        "build": "box compile"
    },
    "config": {
        "sort-packages": true
    }
}
